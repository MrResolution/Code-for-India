# Shell scripts run on Linux: keep them LF even in Windows checkouts
# (core.autocrlf=true would otherwise give them CRLF and bash fails on '\r').
*.sh text eol=lf

# CAD, meshes and board files are binary: never diff or convert them.
*.blend  binary
*.stl    binary
*.STL    binary
*.3mf    binary
*.step   binary
*.sldprt binary
*.pdf    binary
*.zip    binary
