// WiFi and network credentials for the firmware in src/.
// Copy this file to secrets.h and fill in your own values.
// secrets.h is listed in .gitignore and is never committed.

#pragma once

// ── ESP32-CAM SLAM streamer (esp32cam_slam) ─────────────────────────────────

// Your WiFi SSID
#define WIFI_SSID      "your_wifi_name"

// Your WiFi password
#define WIFI_PASSWORD  "your_wifi_password"

// IP address of the laptop / PC running the Python UDP receiver
// Run `ip addr` (Linux) or `ipconfig` (Windows) to find your LAN IP.
#define RECEIVER_IP    "192.168.x.x"

// ── Dogu robot dog (dogu) ───────────────────────────────────────────────────
// Dogu starts its own access point; join it, then open http://192.168.4.1.
// The password must be 8 to 63 characters, or the access point won't start.
#define DOGU_AP_SSID      "DOG_ROBOT"
#define DOGU_AP_PASSWORD  "choose_a_password"
