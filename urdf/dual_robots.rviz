Panels: []
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.4
    Cell Size: 0.05
    Class: rviz_default_plugins/Grid
    Color: 160; 160; 164
    Enabled: true
    Line Style:
      Line Width: 0.01
      Value: Lines
    Name: Grid
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: 0
    Plane: XY
    Plane Cell Count: 20
    Reference Frame: <Fixed Frame>
    Value: true
  - Alpha: 1.0
    Class: rviz_default_plugins/RobotModel
    Collision Enabled: false
    Description Topic:
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /robot_description
    Enabled: true
    Name: RobotModel
    Value: true
    Visual Enabled: true
  - Class: rviz_default_plugins/TF
    Enabled: false
    Marker Scale: 0.03
    Name: TF
    Show Arrows: false
    Show Axes: true
    Show Names: false
    Value: false
  Enabled: true
  Global Options:
    Background Color: 45; 48; 54
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Interact
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.1
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.08
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.02
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.001
      Pitch: 0.45
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
      Yaw: 1.15
Window Geometry:
  Displays:
    collapsed: true
  Height: 900
  Hide Left Dock: true
  Hide Right Dock: true
  QMainWindow State: 
  Views:
    collapsed: true
  Width: 1200
